@model EduPlatform.ViewModels.HomeViewModel
@{
    ViewData["Title"] = "الرئيسية";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<section class="hero">
    <div class="hero-container">
        <div class="hero-content">
            <div class="hero-badge">
                <img src="/images/logo.svg" style="width:20px;height:20px; border-radius:50%;" alt="Alternate Text" />
                منصة يوركا لتدريس الإنجليزية للمرحلة الإعدادية
            </div>
            <h1 class="hero-title">
                ذاكر إنجليزي<br>
                <span>كأنها مغامرة</span><br>
                مش واجب تقيل
            </h1>
            <p class="hero-desc">
                يوركا بتحول كل درس لمهمة، وكل إجابة صح لنقاط، وكل تقدم لإنجاز جديد. فيديوهات منظمة، امتحانات تفاعلية، ومتابعة واضحة للطالب وولي الأمر.
            </p>
            <div class="hero-actions">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/Student/Dashboard" class="btn-hero-primary">
                        <i class="fas fa-user-astronaut"></i>
                        ادخل على بروفايلك
                    </a>
                }
                else
                {
                    <a href="/Account/Register" class="btn-hero-primary">
                        <i class="fas fa-rocket"></i>
                        ابدأ رحلتك
                    </a>
                    <a href="/Account/Login" class="btn-hero-secondary">
                        <i class="fas fa-right-to-bracket"></i>
                        تسجيل الدخول
                    </a>
                }
            </div>
            @* <div class="hero-stats" style="display: none;"> *@
            @*     <div class="hero-stat"> *@
            @*         <div class="hero-stat-num">@Model.TotalStudents</div> *@
            @*         <div class="hero-stat-label">طالب مسجل</div> *@
            @*     </div> *@
            @*     <div class="hero-stat"> *@
            @*         <div class="hero-stat-num">@Model.TotalLessons</div> *@
            @*         <div class="hero-stat-label">درس متاح</div> *@
            @*     </div> *@
            @*     <div class="hero-stat"> *@
            @*         <div class="hero-stat-num">@Model.TotalSubjects</div> *@
            @*         <div class="hero-stat-label">مستوى دراسي</div> *@
            @*     </div> *@
            @* </div> *@
        </div>

        <div class="hero-visual">
            <div class="yurka-bigword">YURKA</div>
            <div class="yurka-mascot">
                <img src="/yurka/assets/gamer-mascot.png" alt="Yurka mascot" />
            </div>
        </div>
    </div>
</section>

<section class="section" style="background:white;">
    <div class="section-container">
        <div class="section-header">
            <span class="section-tag">ليه Yurka؟</span>
            <h2 class="section-title">تعلم منظم، ممتع، <span>ومليان تحديات</span></h2>
            <p class="section-desc">كل حاجة الطالب محتاجها للإنجليزي في مكان واحد: شرح، تدريب، امتحان، نقاط، وبروفايل يتابع تقدمه.</p>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon" style="background:#e8fbff"><i class="fas fa-video" style="color:#00b4db"></i></div>
                <div class="feature-title">فيديوهات شرح مجزأة</div>
                <div class="feature-desc">كل درس مقسم لأجزاء سهلة، عشان الطالب يذاكر خطوة خطوة بدون تشتت.</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon" style="background:#fff3c4"><img src="/images/logo.svg" style="width:50px;height:50px; border-radius:50%;" alt="Alternate Text" /></div>
                <div class="feature-title">نقاط وإنجازات</div>
                <div class="feature-desc">كل إجابة صح تزود نقاط الطالب وتخلي تقدمه واضح ومشجع.</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon" style="background:#ffe0ef"><i class="fas fa-gamepad" style="color:#ff2e93"></i></div>
                <div class="feature-title">أسئلة تفاعلية</div>
                <div class="feature-desc">بعد الشرح الطالب يجاوب ويشوف نتيجة فورية مع تشجيع بصري.</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon" style="background:#ffe3da"><i class="fas fa-headset" style="color:#ff6b47"></i></div>
                <div class="feature-title">حجز ودعم</div>
                <div class="feature-desc">للاستفسارات والحجز الأوفلاين تواصل واتساب على 01008174224.</div>
            </div>
        </div>
    </div>
</section>

<section class="section">
    <div class="section-container">
        <div class="section-header">
            <span class="section-tag">Leaderboard</span>
            <h2 class="section-title">أبطال <span>Yurka</span></h2>
            <p class="section-desc">أعلى الطلاب في النقاط من إجابات الأسئلة والامتحانات.</p>
        </div>

        @if (Model.Leaderboard.Any())
        {
            <div class="features-grid">
                @foreach (var (student, index) in Model.Leaderboard.Select((x, i) => (x, i)))
                {
                    var avatar = string.IsNullOrWhiteSpace(student.ProfileImage) ? "/yurka/assets/avatars/avatar-01.png" : student.ProfileImage;
                    <div class="feature-card" style="text-align:right;">
                        <div style="display:flex; align-items:center; gap:14px;">
                            <div style="width:40px;height:40px;border-radius:50%;background:var(--primary);color:var(--dark);display:flex;align-items:center;justify-content:center;font-weight:900;">#@(index + 1)</div>
                            <img src="@avatar" alt="@student.Name" style="width:62px;height:62px;border-radius:50%;object-fit:cover;object-position:top center;box-shadow:0 0 0 3px #fff,0 0 0 6px var(--primary);" />
                            <div>
                                <div class="feature-title" style="margin-bottom:2px;">@student.Name</div>
                                <div style="color:var(--text-muted); font-size:12px;">@($"{student.Governorate} {student.Markaz}".Trim())</div>
                            </div>
                        </div>
                        <div style="margin-top:18px; display:flex; align-items:center; justify-content:space-between; background:#fff3c4; color:var(--dark); border-radius:14px; padding:12px 14px; font-weight:900;">
                            <span><i class="fas fa-rocket"></i> النقاط</span>
                            <span>@student.Points.ToString("N0")</span>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-trophy"></i>
                <h3>الليدر بورد هيظهر بعد أول امتحانات</h3>
                <p>نقاط الطلاب هتتحسب تلقائيًا من نتائجهم.</p>
            </div>
        }
    </div>
</section>

<section class="section" id="subjects">
    <div class="section-container">
        <div class="section-header">
            <span class="section-tag">اختر مستواك</span>
            <h2 class="section-title">كورسات <span>اللغة الإنجليزية</span></h2>
            <p class="section-desc">المحتوى الحالي يظهر كما هو من لوحة التحكم، مع تصميم يوركا الجديد.</p>
        </div>

        @if (Model.GradeSubjects.Any())
        {
            <div class="grade-tabs">
                <button class="grade-tab active" data-grade="all">كل الصفوف</button>
                @foreach (var grade in Model.GradeSubjects)
                {
                    <button class="grade-tab" data-grade="@((int)grade.Grade)">@grade.GradeName</button>
                }
            </div>

            @foreach (var gradeGroup in Model.GradeSubjects)
            {
                <div class="grade-section" data-grade="@((int)gradeGroup.Grade)">
                    <h3 class="grade-title">@gradeGroup.GradeName</h3>
                    <div class="subjects-grid">
                        @foreach (var subject in gradeGroup.Subjects)
                        {
                            var colors = new[] { "#e8fbff", "#fff3c4", "#ffe0ef", "#ffe3da" };
                            var colorIdx = subject.Id % colors.Length;
                            <a href="/Subject/Detail/@subject.Id" class="subject-card">
                                <div class="subject-card-top" style="background:@colors[colorIdx]">
                                    <span>@(subject.IconClass ?? "🔤")</span>
                                </div>
                                <div class="subject-card-body">
                                    <div class="subject-card-name">@subject.Name</div>
                                    <div class="subject-card-meta">
                                        <div class="subject-card-units">
                                            <i class="fas fa-layer-group"></i>
                                            @subject.Units.Count(u => u.IsActive) وحدة
                                        </div>
                                        <div class="subject-card-arrow">
                                            <i class="fas fa-arrow-left"></i>
                                        </div>
                                    </div>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-book-open"></i>
                <h3>الكورسات قيد الإعداد</h3>
                <p>سيتم إضافة كورسات يوركا قريبًا من لوحة التحكم.</p>
            </div>
        }
    </div>
</section>

<section class="section" style="background:white;">
    <div class="section-container">
        <div class="section-header">
            <span class="section-tag">الاشتراك</span>
            <h2 class="section-title">اختار <span>شهر أو ترم كامل</span></h2>
            <p class="section-desc">نظام الدفع الحالي كما هو: الطالب يرسل الطلب ويتم تأكيده من لوحة التحكم بعد المراجعة.</p>
        </div>
        <div class="features-grid">
            <div class="feature-card">
                <div class="feature-icon" style="background:#e8fbff"><i class="fas fa-calendar-days" style="color:#00b4db"></i></div>
                <div class="feature-title">اشتراك شهري</div>
                <div class="feature-desc">مناسب لو عايز تبدأ بشهر محدد وتتابع وحداته ودروسه.</div>
            </div>
            <div class="feature-card">
                <div class="feature-icon" style="background:#fff3c4"><i class="fas fa-trophy" style="color:#c99e00"></i></div>
                <div class="feature-title">اشتراك الترم</div>
                <div class="feature-desc">اختيار أقوى للمتابعة المستمرة وتجميع النقاط على مدار الترم.</div>
            </div>
        </div>
    </div>
</section>
