@model EduPlatform.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "تسجيل الدخول";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="auth-page yk-login-page">
    <div class="yk-login-wrap">

        <div class="yk-login-grid">

            <!-- ===== FORM SIDE ===== -->
            <div class="auth-card yk-login-card">
                <div class="yk-login-brand">
                    <div class="auth-logo-icon">
                        <i class="fas fa-gamepad"></i>
                    </div>
                    <h1>Yurka</h1>
                    <p>بوابة اللاعبين</p>
                </div>

                <h2 class="auth-title" style="margin-top:20px;">تسجيل الدخول</h2>
                <p class="yk-panel-desc">ادخل بياناتك وكمل مغامرتك من حيث وقفت.</p>

                <form asp-controller="Account" asp-action="Login" asp-route-returnUrl="@ViewData["ReturnUrl"]" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label class="form-label">البريد أو الهاتف أو الاسم <span>*</span></label>
                        <input asp-for="Email" class="form-control" placeholder="email@example.com أو 01XXXXXXXXX" required />
                        <span asp-validation-for="Email" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label class="form-label">كلمة المرور <span>*</span></label>
                        <div class="yk-pass-wrap">
                            <input asp-for="Password" type="password" class="form-control" id="loginPass" required />
                            <button type="button" class="yk-pass-toggle" onclick="toggleLoginPass()">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>
                        <span asp-validation-for="Password" class="field-validation-error"></span>
                    </div>

                    <div class="form-group" style="margin-bottom:8px;">
                        <label class="form-check">
                            <input asp-for="RememberMe" type="checkbox" />
                            <span>تذكرني</span>
                        </label>
                    </div>

                    @if (!ViewData.ModelState.IsValid)
                    {
                        <div class="yk-error-box">
                            <i class="fas fa-exclamation-circle"></i>
                            @Html.ValidationSummary(true)
                        </div>
                    }

                    <button type="submit" class="btn btn-primary btn-full btn-lg" style="margin-top:8px;">
                        <i class="fas fa-rocket"></i> يلا نبدأ
                    </button>
                </form>

                <div class="yk-auth-link" style="margin-top:20px;">
                    لسه جديد في يوركا؟ <a href="/Account/Register">سجل دلوقتي</a>
                </div>
            </div>

            <!-- ===== MASCOT SIDE ===== -->
            <div class="yk-login-mascot-side">
                <div class="yurka-bigword" aria-hidden="true">YURKA</div>
                <div class="yurka-mascot">
                    <img src="/yurka/assets/boy-mascot.png" alt="Yurka Mascot" />
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <script>
        function toggleLoginPass() {
            const inp = document.getElementById('loginPass');
            const ico = document.querySelector('.yk-pass-toggle i');
            if (inp.type === 'password') {
                inp.type = 'text';
                ico.className = 'fas fa-eye-slash';
            } else {
                inp.type = 'password';
                ico.className = 'fas fa-eye';
            }
        }
    </script>
}

