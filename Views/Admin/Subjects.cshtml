@model List<EduPlatform.Models.Subject>
@{
    ViewData["Title"] = "إدارة المواد";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-layout">
    <aside class="dashboard-sidebar">
        <nav class="sidebar-nav" style="padding-top:24px;">
            <a href="/Admin" class="sidebar-link"><i class="fas fa-tachometer-alt"></i> الرئيسية</a>
            <a href="/Admin/Payments" class="sidebar-link"><i class="fas fa-receipt"></i> طلبات الدفع</a>
            <a href="/Admin/Subjects" class="sidebar-link active"><i class="fas fa-book"></i> المواد</a>
            <a href="/Admin/Students" class="sidebar-link"><i class="fas fa-users"></i> الطلاب</a>
        </nav>
    </aside>

    <main class="dashboard-main">
        <div class="dashboard-header">
            <div class="dashboard-title">إدارة المواد الدراسية</div>
            <a href="/Admin/CreateSubject" class="btn btn-primary"><i class="fas fa-plus"></i> إضافة مادة جديدة</a>
        </div>

        <div class="admin-table-card">
            <table class="table">
                <thead>
                    <tr>
                        <th>المادة</th>
                        <th>الصف</th>
                        <th>الوحدات</th>
                        <th>الحالة</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        <tr>
                            <td>
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <span style="font-size:24px">@(s.IconClass ?? "🔤")</span>
                                    <div>
                                        <strong>@s.Name</strong>
                                        @if (!string.IsNullOrWhiteSpace(s.Description))
                                        {
                                            <div style="font-size:12px; color:var(--text-muted);">@s.Description</div>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td><span class="badge badge-primary">الصف @((int)s.GradeLevel)</span></td>
                            <td>@s.Units.Count وحدة</td>
                            <td>
                                @if (s.IsActive) { <span class="badge badge-success">نشط</span> }
                                else { <span class="badge badge-danger">مخفي</span> }
                            </td>
                            <td>
                                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                    <a href="/Admin/Units/@s.Id" class="btn btn-sm btn-primary"><i class="fas fa-layer-group"></i> الوحدات</a>
                                    <a href="/Admin/EditSubject/@s.Id" class="btn btn-sm btn-outline"><i class="fas fa-edit"></i> تعديل</a>
                                    <form asp-controller="Admin" asp-action="DeleteSubject" method="post" class="d-inline" onsubmit="return confirm('حذف المادة سيحذف وحداتها وامتحاناتها. هل أنت متأكد؟');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i> حذف</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>
