@model EduPlatform.ViewModels.VideoQuestionAdminViewModel
@{
    ViewData["Title"] = "أسئلة الفيديو";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-layout">
    <aside class="dashboard-sidebar">
        <nav class="sidebar-nav" style="padding-top:24px;">
            <a href="/Admin" class="sidebar-link"><i class="fas fa-tachometer-alt"></i> الرئيسية</a>
            <a href="/Admin/Lessons/@Model.Lesson.UnitId" class="sidebar-link"><i class="fas fa-video"></i> الدروس</a>
        </nav>
    </aside>

    <main class="dashboard-main">
        <div class="dashboard-header">
            <div>
                <div class="breadcrumb" style="margin-bottom:4px;">
                    <a href="/Admin/Lessons/@Model.Lesson.UnitId">الدروس</a>
                    <i class="fas fa-chevron-left"></i>
                    <span>@Model.Lesson.Title</span>
                </div>
                <div class="dashboard-title">أسئلة الفيديو التفاعلية</div>
                <div style="color:var(--text-muted); font-size:14px;">حدد وقت ظهور السؤال داخل الفيديو، والطالب يجاوب من صفحة الدرس.</div>
            </div>
            <a href="/Unit/Watch/@Model.Lesson.Id" target="_blank" class="btn btn-outline">
                <i class="fas fa-play"></i> معاينة الدرس
            </a>
        </div>

        <div style="display:grid; grid-template-columns:minmax(0,1fr) 420px; gap:24px; align-items:start;">
            <div class="admin-table-card">
                @if (!Model.Questions.Any())
                {
                    <div class="empty-state">
                        <i class="fas fa-bolt"></i>
                        <h3>لا توجد أسئلة فيديو بعد</h3>
                        <p>أضف أول سؤال وحدد وقت ظهوره أثناء الفيديو.</p>
                    </div>
                }
                else
                {
                    <table class="table">
                        <thead>
                            <tr>
                                <th>الوقت</th>
                                <th>السؤال</th>
                                <th>النقاط</th>
                                <th>الحالة</th>
                                <th>إجراءات</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var q in Model.Questions)
                            {
                                var minute = q.TriggerSecond / 60;
                                var second = q.TriggerSecond % 60;
                                <tr>
                                    <td><strong>@minute:@second.ToString("00")</strong></td>
                                    <td>
                                        <div style="font-weight:800;">@q.Text</div>
                                        <div style="display:flex; gap:6px; flex-wrap:wrap; margin-top:8px;">
                                            @foreach (var answer in q.Answers.OrderBy(a => a.SortOrder))
                                            {
                                                <span class="badge @(answer.IsCorrect ? "badge-success" : "badge-info")">
                                                    @(answer.IsCorrect ? "صح: " : "")@answer.Text
                                                </span>
                                            }
                                        </div>
                                    </td>
                                    <td>@q.Points</td>
                                    <td>
                                        <span class="badge @(q.IsActive ? "badge-success" : "badge-danger")">
                                            @(q.IsActive ? "نشط" : "مخفي")
                                        </span>
                                    </td>
                                    <td>
                                        <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                            <form asp-controller="Admin" asp-action="ToggleVideoQuestion" method="post">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@q.Id" />
                                                <button class="btn btn-sm btn-outline" type="submit">
                                                    <i class="fas fa-power-off"></i>
                                                </button>
                                            </form>
                                            <form asp-controller="Admin" asp-action="DeleteVideoQuestion" method="post" onsubmit="return confirm('حذف السؤال سيحذف إجابات الطلاب عليه. هل أنت متأكد؟');">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@q.Id" />
                                                <button class="btn btn-sm btn-danger" type="submit">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            <div class="form-card">
                <h3 style="font-size:18px; font-weight:900; margin-bottom:16px;">إضافة سؤال</h3>
                <form asp-controller="Admin" asp-action="AddVideoQuestion" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="lessonId" value="@Model.Lesson.Id" />

                    <div class="form-group">
                        <label class="form-label">نص السؤال <span>*</span></label>
                        <textarea name="text" class="form-control" rows="3" required></textarea>
                    </div>

                    <div style="display:grid; grid-template-columns:1fr 1fr 1fr; gap:12px;">
                        <div class="form-group">
                            <label class="form-label">الدقيقة</label>
                            <input name="triggerMinute" type="number" min="0" class="form-control" value="0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">الثانية</label>
                            <input name="triggerSecond" type="number" min="0" max="59" class="form-control" value="0" />
                        </div>
                        <div class="form-group">
                            <label class="form-label">النقاط</label>
                            <input name="points" type="number" min="1" max="10" class="form-control" value="1" />
                        </div>
                    </div>

                    <div class="form-group">
                        <label class="form-label">الإجابات <span>*</span></label>
                        <div style="display:flex; flex-direction:column; gap:10px;">
                            @for (var i = 0; i < 4; i++)
                            {
                                <div style="display:grid; grid-template-columns:auto 1fr; gap:10px; align-items:center;">
                                    <label style="display:flex; gap:6px; align-items:center; font-size:13px; color:var(--text-muted);">
                                        <input type="radio" name="correctAnswerIndex" value="@i" @(i == 0 ? "checked" : "") />
                                        صح
                                    </label>
                                    <input name="answerTexts" class="form-control" placeholder="إجابة @(i + 1)" @(i < 2 ? "required" : "") />
                                </div>
                            }
                        </div>
                    </div>

                    <button class="btn btn-primary btn-full" type="submit">
                        <i class="fas fa-plus-circle"></i> إضافة السؤال
                    </button>
                </form>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <style>
        @@media (max-width: 980px) {
            .dashboard-main > div[style*="grid-template-columns"] {
                grid-template-columns: 1fr !important;
            }
        }
    </style>
}
