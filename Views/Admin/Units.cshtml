@model EduPlatform.Models.Subject
@{
    ViewData["Title"] = "إدارة الوحدات";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-layout">
    <aside class="dashboard-sidebar">
        <nav class="sidebar-nav" style="padding-top:24px;">
            <a href="/Admin" class="sidebar-link"><i class="fas fa-tachometer-alt"></i> الرئيسية</a>
            <a href="/Admin/Subjects" class="sidebar-link"><i class="fas fa-book"></i> المواد</a>
        </nav>
    </aside>
    <main class="dashboard-main">
        <div class="dashboard-header">
            <div>
                <div class="dashboard-title">وحدات: @Model.Name</div>
                <div style="color:var(--text-muted); font-size:14px;">الصف @((int)Model.GradeLevel)</div>
            </div>
            <a href="/Admin/CreateUnit/@Model.Id" class="btn btn-primary"><i class="fas fa-plus"></i> إضافة وحدة</a>
        </div>

        <div class="admin-table-card">
            @if (!Model.Units.Any())
            {
                <div class="empty-state"><i class="fas fa-layer-group"></i><h3>لا توجد وحدات بعد</h3></div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>الوحدة</th>
                            <th>السعر</th>
                            <th>الترتيب</th>
                            <th>الحالة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                    @foreach (var u in Model.Units.OrderBy(x => x.SortOrder))
                    {
                        <tr>
                            <td><strong>@u.Title</strong></td>
                            <td><strong style="color:var(--primary)">@u.Price.ToString("N0") جنيه</strong></td>
                            <td>@u.SortOrder</td>
                            <td>
                                @if (u.IsActive) { <span class="badge badge-success">نشطة</span> }
                                else { <span class="badge badge-danger">مخفية</span> }
                            </td>
                            <td>
                                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                    <a href="/Admin/Lessons/@u.Id" class="btn btn-sm btn-primary"><i class="fas fa-video"></i> الدروس</a>
                                    <a href="/Admin/Exams?unitId=@u.Id" class="btn btn-sm btn-outline"><i class="fas fa-tasks"></i> امتحانات</a>
                                    <a href="/Admin/EditUnit/@u.Id" class="btn btn-sm btn-outline"><i class="fas fa-edit"></i> تعديل</a>
                                    <form asp-controller="AdminExt" asp-action="ToggleUnit" asp-route-id="@u.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline"><i class="fas fa-power-off"></i> @(u.IsActive ? "إخفاء" : "تفعيل")</button>
                                    </form>
                                    <form asp-controller="Admin" asp-action="DeleteUnit" method="post" class="d-inline" onsubmit="return confirm('حذف الوحدة سيحذف دروسها وامتحاناتها واشتراكاتها. هل أنت متأكد؟');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@u.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i> حذف</button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            }
        </div>
    </main>
</div>
