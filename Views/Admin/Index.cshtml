@model EduPlatform.ViewModels.AdminDashboardViewModel
@{
    ViewData["Title"] = "لوحة تحكم الأدمن";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-layout">
    <!-- Admin Sidebar -->
    <aside class="dashboard-sidebar">
        <div class="sidebar-user">
            <div class="sidebar-avatar" style="background:linear-gradient(135deg,#f59e0b,#f97316)">
                <i class="fas fa-user-shield"></i>
            </div>
            <div class="sidebar-name">لوحة الأدمن</div>
            <div class="sidebar-grade" style="color:rgba(245,158,11,0.7)">مدير المنصة</div>
        </div>
        <nav class="sidebar-nav">
            <a href="/Admin" class="sidebar-link active"><i class="fas fa-tachometer-alt"></i> الرئيسية</a>
            <a href="/Admin/Payments" class="sidebar-link">
                <i class="fas fa-receipt"></i> طلبات الدفع
                @if (Model.PendingPayments > 0)
                {
                    <span style="background:var(--danger); color:white; border-radius:50px; padding:1px 8px; font-size:11px; margin-right:auto;">@Model.PendingPayments</span>
                }
            </a>
            <a href="/Admin/Subjects" class="sidebar-link"><i class="fas fa-book"></i> المواد الدراسية</a>
            <a href="/Admin/Students" class="sidebar-link"><i class="fas fa-users"></i> الطلاب</a>
            <div style="border-top:1px solid rgba(255,255,255,0.08); margin:12px 0;"></div>
            <a href="/" class="sidebar-link"><i class="fas fa-external-link-alt"></i> عرض الموقع</a>
        </nav>
    </aside>

    <!-- Main -->
    <main class="dashboard-main">
        <div class="dashboard-header">
            <div>
                <div class="dashboard-title">لوحة التحكم</div>
                <div style="color:var(--text-muted); font-size:14px; margin-top:4px;">مرحباً بك في لوحة إدارة المنصة</div>
            </div>
        </div>

        <!-- Stats -->
        <div class="stats-grid">
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(26,60,107,0.1)">
                    <i class="fas fa-users" style="color:var(--primary)"></i>
                </div>
                <div class="stat-info">
                    <h3>@Model.TotalStudents</h3>
                    <p>طالب مسجل</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(16,185,129,0.1)">
                    <i class="fas fa-dollar-sign" style="color:var(--success)"></i>
                </div>
                <div class="stat-info">
                    <h3>@Model.TotalRevenue.ToString("N0")</h3>
                    <p>جنيه إيرادات</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(239,68,68,0.1)">
                    <i class="fas fa-bell" style="color:var(--danger)"></i>
                </div>
                <div class="stat-info">
                    <h3>@Model.PendingPayments</h3>
                    <p>طلب دفع معلق</p>
                </div>
            </div>
            <div class="stat-card">
                <div class="stat-icon" style="background:rgba(245,158,11,0.1)">
                    <i class="fas fa-video" style="color:var(--accent)"></i>
                </div>
                <div class="stat-info">
                    <h3>@Model.TotalLessons</h3>
                    <p>درس مضاف</p>
                </div>
            </div>
        </div>

        <!-- Quick Actions -->
        <div style="background:white; border-radius:var(--radius); border:1px solid var(--border); padding:24px; margin-bottom:24px;">
            <h3 style="font-size:16px; font-weight:700; color:var(--dark); margin-bottom:16px;">
                <i class="fas fa-bolt" style="color:var(--accent)"></i> إجراءات سريعة
            </h3>
            <div style="display:flex; gap:12px; flex-wrap:wrap;">
                <a href="/Admin/Payments" class="btn btn-primary btn-sm">
                    <i class="fas fa-receipt"></i> مراجعة الدفعات
                    @if (Model.PendingPayments > 0)
                    {
                        <span style="background:rgba(255,255,255,0.25); border-radius:50px; padding:0 8px; font-size:12px;">@Model.PendingPayments</span>
                    }
                </a>
                <a href="/Admin/Subjects" class="btn btn-outline btn-sm">
                    <i class="fas fa-plus"></i> إضافة مادة
                </a>
                <a href="/Admin/Students" class="btn btn-outline btn-sm">
                    <i class="fas fa-users"></i> إدارة الطلاب
                </a>
            </div>
        </div>

        <!-- Pending Payments Table -->
        @if (Model.RecentPayments.Any(p => p.Status == EduPlatform.Models.PaymentStatus.Pending))
        {
            <div class="admin-table-card" style="margin-bottom:24px;">
                <div class="admin-table-header">
                    <h3 style="color:var(--danger)"><i class="fas fa-exclamation-circle"></i> طلبات الدفع المعلقة</h3>
                    <a href="/Admin/Payments?status=Pending" class="btn btn-sm btn-outline">عرض الكل</a>
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <th>الطالب</th>
                            <th>الوحدة</th>
                            <th>المبلغ</th>
                            <th>مرجع التحويل</th>
                            <th>التاريخ</th>
                            <th>إجراء</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var p in Model.RecentPayments.Where(x => x.Status == EduPlatform.Models.PaymentStatus.Pending))
                        {
                            <tr>
                                <td>
                                    <div style="font-weight:600">@p.User.FullName</div>
                                    <div style="font-size:12px; color:var(--text-muted)">@p.VodafonePhone</div>
                                </td>
                                <td>
                                    <div>@p.Unit.Title</div>
                                    <div style="font-size:12px; color:var(--text-muted)">@p.Unit.Subject?.Name</div>
                                </td>
                                <td><strong style="color:var(--primary)">@p.Amount.ToString("N0") جنيه</strong></td>
                                <td style="font-size:13px; color:var(--text-muted)">@p.TransactionReference</td>
                                <td style="font-size:12px; color:var(--text-muted)">@p.RequestedAt.ToString("dd/MM HH:mm")</td>
                                <td>
                                    <div style="display:flex; gap:8px;">
                                        <form asp-controller="Admin" asp-action="ConfirmPayment" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-success btn-sm"
                                                    data-confirm="تأكيد دفع @p.User.FullName؟">
                                                <i class="fas fa-check"></i> قبول
                                            </button>
                                        </form>
                                        <form asp-controller="Admin" asp-action="RejectPayment" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@p.Id" />
                                            <button type="submit" class="btn btn-danger btn-sm"
                                                    data-confirm="رفض طلب @p.User.FullName؟">
                                                <i class="fas fa-times"></i> رفض
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <!-- Recent Students -->
        <div class="admin-table-card">
            <div class="admin-table-header">
                <h3><i class="fas fa-users" style="color:var(--primary)"></i> آخر الطلاب المسجلين</h3>
                <a href="/Admin/Students" class="btn btn-sm btn-outline">عرض الكل</a>
            </div>
            <table class="table">
                <thead>
                    <tr>
                        <th>الاسم</th>
                        <th>البريد الإلكتروني</th>
                        <th>تاريخ التسجيل</th>
                        <th>الحالة</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model.RecentStudents)
                    {
                        <tr>
                            <td>
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <div style="width:36px; height:36px; background:linear-gradient(135deg,var(--primary),var(--primary-light)); border-radius:10px; display:flex; align-items:center; justify-content:center; color:white; font-weight:700; font-size:15px;">
                                        @s.FullName.Substring(0, 1)
                                    </div>
                                    <strong>@s.FullName</strong>
                                </div>
                            </td>
                            <td style="color:var(--text-muted); font-size:13px;">@s.Email</td>
                            <td style="color:var(--text-muted); font-size:13px;">@s.CreatedAt.ToString("dd/MM/yyyy")</td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge badge-success">نشط</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">موقوف</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>
