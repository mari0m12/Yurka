@model EduPlatform.Models.Unit
@{
    ViewData["Title"] = "إدارة الدروس";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-layout">
    <aside class="dashboard-sidebar">
        <nav class="sidebar-nav" style="padding-top:24px;">
            <a href="/Admin" class="sidebar-link"><i class="fas fa-tachometer-alt"></i> الرئيسية</a>
            <a href="/Admin/Subjects" class="sidebar-link"><i class="fas fa-book"></i> المواد</a>
            <a href="/Admin/Units/@Model.SubjectId" class="sidebar-link"><i class="fas fa-layer-group"></i> الوحدات</a>
        </nav>
    </aside>
    <main class="dashboard-main">
        <div class="dashboard-header">
            <div>
                <div class="breadcrumb" style="margin-bottom:4px;">
                    <a href="/Admin/Subjects">المواد</a>
                    <i class="fas fa-chevron-left"></i>
                    <a href="/Admin/Units/@Model.SubjectId">@Model.Subject?.Name</a>
                    <i class="fas fa-chevron-left"></i>
                    <span>@Model.Title</span>
                </div>
                <div class="dashboard-title">دروس: @Model.Title</div>
            </div>
            <a href="/Admin/CreateLesson/@Model.Id" class="btn btn-primary">
                <i class="fas fa-plus"></i> إضافة درس
            </a>
        </div>

        <div class="admin-table-card">
            @if (!Model.Lessons.Any())
            {
                <div class="empty-state">
                    <i class="fas fa-video-slash"></i>
                    <h3>لا توجد دروس بعد</h3>
                    <p>أضف أول درس لهذه الوحدة</p>
                    <a href="/Admin/CreateLesson/@Model.Id" class="btn btn-primary" style="margin-top:16px;">
                        <i class="fas fa-plus"></i> إضافة درس
                    </a>
                </div>
            }
            else
            {
                <table class="table">
                    <thead>
                        <tr>
                            <th>#</th>
                            <th>عنوان الدرس</th>
                            <th>يوتيوب ID</th>
                            <th>المدة</th>
                            <th>معاينة مجانية</th>
                            <th>الحالة</th>
                            <th>إجراءات</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var l in Model.Lessons.OrderBy(x => x.SortOrder))
                        {
                            <tr>
                                <td style="color:var(--text-muted);">@l.SortOrder</td>
                                <td>
                                    <div style="font-weight:600;">@l.Title</div>
                                    @if (!string.IsNullOrEmpty(l.Description))
                                    {
                                        <div style="font-size:12px; color:var(--text-muted); margin-top:2px;">
                                            @(l.Description.Length > 60 ? l.Description.Substring(0, 60) + "..." : l.Description)
                                        </div>
                                    }
                                </td>
                                <td>
                                    <a href="https://youtube.com/watch?v=@l.YoutubeVideoId" target="_blank"
                                       style="color:var(--danger); font-family:monospace; font-size:13px; text-decoration:none;">
                                        <i class="fab fa-youtube"></i> @l.YoutubeVideoId
                                    </a>
                                </td>
                                <td>
                                    @if (l.DurationMinutes > 0)
                                    {
                                        <span><i class="fas fa-clock" style="color:var(--text-muted)"></i> @l.DurationMinutes د</span>
                                    }
                                    else
                                    {
                                        <span style="color:var(--text-muted)">—</span>
                                    }
                                </td>
                                <td>
                                    @if (l.IsFreePreview)
                                    {
                                        <span class="badge badge-success"><i class="fas fa-unlock"></i> مجاني</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-info"><i class="fas fa-lock"></i> مدفوع</span>
                                    }
                                </td>
                                <td>
                                    @if (l.IsActive)
                                    {
                                        <span class="badge badge-success">نشط</span>
                                    }
                                    else
                                    {
                                        <span class="badge badge-danger">مخفي</span>
                                    }
                                </td>
                                <td>
                                    <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                        <a href="/Admin/Exams?lessonId=@l.Id" class="btn btn-sm btn-outline">
                                            <i class="fas fa-tasks"></i> امتحانات
                                        </a>
                                        <a href="/Admin/VideoQuestions?lessonId=@l.Id" class="btn btn-sm btn-primary">
                                            <i class="fas fa-bolt"></i> أسئلة الفيديو
                                        </a>
                                        <a href="/Admin/EditLesson/@l.Id" class="btn btn-sm btn-outline">
                                            <i class="fas fa-edit"></i> تعديل
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </main>
</div>
