@model List<EduPlatform.Models.ApplicationUser>
@{
    ViewData["Title"] = "إدارة الطلاب";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="dashboard-layout">
    <aside class="dashboard-sidebar">
        <nav class="sidebar-nav" style="padding-top:24px;">
            <a href="/Admin" class="sidebar-link"><i class="fas fa-tachometer-alt"></i> الرئيسية</a>
            <a href="/Admin/Payments" class="sidebar-link"><i class="fas fa-receipt"></i> طلبات الدفع</a>
            <a href="/Admin/Subjects" class="sidebar-link"><i class="fas fa-book"></i> المواد</a>
            <a href="/Admin/Students" class="sidebar-link active"><i class="fas fa-users"></i> الطلاب</a>
        </nav>
    </aside>
    <main class="dashboard-main">
        <div class="dashboard-header">
            <div class="dashboard-title">إدارة الطلاب</div>
            <div style="display:flex; align-items:center; gap:12px; flex-wrap:wrap;">
                <div style="background:white; border:1px solid var(--border); border-radius:var(--radius-sm); padding:8px 16px; display:flex; align-items:center; gap:8px;">
                    <i class="fas fa-search" style="color:var(--text-muted);"></i>
                    <input type="text" id="searchInput" placeholder="ابحث عن طالب..."
                           style="border:none; outline:none; font-family:var(--font); font-size:14px; width:200px;" />
                </div>
                <a href="/Admin/CreateStudent" class="btn btn-primary"><i class="fas fa-plus"></i> إضافة طالب</a>
                <span class="badge badge-primary" style="font-size:14px; padding:8px 16px;">@Model.Count طالب</span>
            </div>
        </div>

        <div class="admin-table-card">
            <table class="table" id="studentsTable">
                <thead>
                    <tr>
                        <th>الطالب</th>
                        <th>البريد الإلكتروني</th>
                        <th>الهاتف</th>
                        <th>ولي الأمر</th>
                        <th>الموقع</th>
                        <th>الصف</th>
                        <th>الحالة</th>
                        <th>إجراءات</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var s in Model)
                    {
                        var avatar = string.IsNullOrWhiteSpace(s.ProfileImage) ? "/yurka/assets/avatars/avatar-01.png" : s.ProfileImage;
                        string gradeName = s.GradeLevel.HasValue ? ((int)s.GradeLevel.Value) switch
                        {
                            7 => "الأول الإعدادي",
                            8 => "الثاني الإعدادي",
                            9 => "الثالث الإعدادي",
                            _ => $"الصف {(int)s.GradeLevel.Value}"
                        } : "غير محدد";
                        <tr class="student-row">
                            <td>
                                <div style="display:flex; align-items:center; gap:10px;">
                                    <img src="@avatar" alt="" style="width:42px;height:42px;border-radius:50%;object-fit:cover;object-position:top center;" />
                                    <div>
                                        <div style="font-weight:700;" class="student-name">@s.FullName</div>
                                        <div style="font-size:12px;color:var(--text-muted);">@s.CreatedAt.ToString("dd/MM/yyyy")</div>
                                    </div>
                                </div>
                            </td>
                            <td style="font-size:13px; color:var(--text-muted);">@s.Email</td>
                            <td style="font-size:13px; color:var(--text-muted);">@(s.Phone ?? "-")</td>
                            <td style="font-size:13px; color:var(--text-muted);">@(s.ParentPhone ?? "-")</td>
                            <td style="font-size:13px; color:var(--text-muted);">@($"{s.Governorate} {s.Markaz}".Trim())</td>
                            <td><span class="badge badge-primary">@gradeName</span></td>
                            <td>
                                @if (s.IsActive)
                                {
                                    <span class="badge badge-success">نشط</span>
                                }
                                else
                                {
                                    <span class="badge badge-danger">موقوف</span>
                                }
                            </td>
                            <td>
                                <div style="display:flex; gap:8px; flex-wrap:wrap;">
                                    <a href="/Admin/StudentDetail/@s.Id" class="btn btn-sm btn-outline"><i class="fas fa-eye"></i></a>
                                    <a href="/Admin/EditStudent/@s.Id" class="btn btn-sm btn-primary"><i class="fas fa-edit"></i></a>
                                    <form asp-controller="Admin" asp-action="DeleteStudent" method="post" class="d-inline" onsubmit="return confirm('حذف الطالب سيحذف بياناته ونتائجه واشتراكاته. هل أنت متأكد؟');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@s.Id" />
                                        <button type="submit" class="btn btn-sm btn-danger"><i class="fas fa-trash"></i></button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        document.getElementById('searchInput').addEventListener('input', function () {
            const q = this.value.toLowerCase();
            document.querySelectorAll('.student-row').forEach(row => {
                const text = row.textContent.toLowerCase();
                row.style.display = text.includes(q) ? '' : 'none';
            });
        });
    </script>
}
